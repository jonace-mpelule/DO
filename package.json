{
  "name": "@jonacem/do-file",
  "version": "0.2.0",
  "description": "A small YAML task runner with dependencies, arguments, and env-file interpolation.",
  "type": "module",
  "bin": {
    "dof": "dist/do.js",
    "do-file": "dist/do.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "task-runner",
    "makefile",
    "yaml",
    "cli",
    "bun"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile dist/do.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "effect": "^3.22.1",
    "typescript": "^7.0.2"
  }
}
